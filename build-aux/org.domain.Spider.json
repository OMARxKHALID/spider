{
    "id": "org.domain.Spider",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "org.domain.Spider",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--env=TESSDATA_PREFIX=/app/share/tessdata"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/opencv4",
        "/share/licenses",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "python3-numpy",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation numpy"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/3a/1b/3b16a9bc514a440a7a0883684111dcb1ef1aee960af2ca95da8fc775f124/numpy-2.5.3-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
                    "sha256": "a5fa86b80fd24bcd1aff83ad23be44ea323de3f787be8f8b15d4a65621e25321"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "https://files.pythonhosted.org/packages/73/85/735720d04ec197c5dcfacdfc9922667c7f1f5f496a279b7ba4d7c74c4cc7/numpy-2.5.3-cp313-cp313-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
                    "sha256": "c76d5dde9f445058f83d0c02af00557a4db91de9a9a57c0df87d1535001d654b"
                }
            ]
        },
        {
            "name": "opencv",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_LIST=core,imgproc,imgcodecs,python3",
                "-DBUILD_opencv_python3=ON",
                "-DOPENCV_SKIP_PYTHON_LOADER=ON",
                "-DOPENCV_PYTHON3_INSTALL_PATH=lib/python3.13/site-packages",
                "-DPYTHON3_EXECUTABLE=/usr/bin/python3",
                "-DPYTHON3_NUMPY_INCLUDE_DIRS=/app/lib/python3.13/site-packages/numpy/_core/include",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_PERF_TESTS=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_DOCS=OFF",
                "-DBUILD_JAVA=OFF",
                "-DBUILD_opencv_apps=OFF",
                "-DBUILD_PNG=OFF",
                "-DBUILD_JPEG=OFF",
                "-DBUILD_TIFF=OFF",
                "-DBUILD_WEBP=OFF",
                "-DBUILD_ZLIB=OFF",
                "-DWITH_IPP=OFF",
                "-DWITH_ITT=OFF",
                "-DWITH_ADE=OFF",
                "-DWITH_KLEIDICV=OFF",
                "-DWITH_OPENCL=OFF",
                "-DWITH_FFMPEG=OFF",
                "-DWITH_GSTREAMER=OFF",
                "-DWITH_V4L=OFF",
                "-DWITH_GTK=OFF",
                "-DWITH_QT=OFF",
                "-DWITH_EIGEN=OFF",
                "-DWITH_LAPACK=OFF",
                "-DWITH_PROTOBUF=OFF",
                "-DWITH_OPENEXR=OFF",
                "-DWITH_OPENJPEG=OFF",
                "-DWITH_JASPER=OFF",
                "-DOPENCV_GENERATE_PKGCONFIG=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv/archive/refs/tags/4.13.0.tar.gz",
                    "sha256": "1d40ca017ea51c533cf9fd5cbde5b5fe7ae248291ddf2af99d4c17cf8e13017d"
                }
            ]
        },
        {
            "name": "leptonica",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_PROG=OFF",
                "-DSW_BUILD=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/DanBloomberg/leptonica/releases/download/1.87.0/leptonica-1.87.0.tar.gz",
                    "sha256": "c73363397f96eb1295602bf44d708a994ad42046c791bf03ea0505d829bdb6a7"
                }
            ]
        },
        {
            "name": "tesseract",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_TRAINING_TOOLS=OFF",
                "-DBUILD_TESTS=OFF",
                "-DGRAPHICS_DISABLED=ON",
                "-DDISABLE_ARCHIVE=ON",
                "-DDISABLE_CURL=ON",
                "-DOPENMP_BUILD=OFF",
                "-DSW_BUILD=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.3.tar.gz",
                    "sha256": "9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884"
                }
            ]
        },
        {
            "name": "tessdata",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 eng.traineddata ${FLATPAK_DEST}/share/tessdata/eng.traineddata"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/tesseract-ocr/tessdata_fast/raw/4.1.0/eng.traineddata",
                    "sha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
                }
            ]
        },
        {
            "name": "spider",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        ".venv",
                        "builddir",
                        "build",
                        "build-dir",
                        ".flatpak-builder",
                        "spider_1.1.0_all.deb"
                    ]
                }
            ]
        }
    ]
}
